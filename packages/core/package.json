{
  "name": "@quantum-js/core",
  "version": "0.1.0",
  "type": "module",
  "description": "A lightweight reactive UI framework powered by Signals and Automatic JSX.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "quantum-js",
    "framework",
    "jsx",
    "signal",
    "reactive",
    "ui"
  ],
  "author": "haiminh256",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}